# Copiar a deploy/.env (no se versiona) y ajustar.

# URL con la que se entra a la wiki; fuera de localhost tiene que ser https (SPEC §21.2).
KUDAWIKI_BASE_URL=http://localhost:8080

# Primer superadmin, solo para `docker compose run --rm init`.
# La contraseña no va aquí: init la pide por consola.
KUDAWIKI_INIT_EMAIL=tu@empresa.cl
KUDAWIKI_INIT_NAME=Tu Nombre
