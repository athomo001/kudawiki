# Copiar a .env, al lado de compose.yaml (no se versiona), y ajustar.

# Versión de la imagen (ghcr.io/athomo001/kudawiki). "1" toma la última 1.x en cada
# `docker compose pull`; una exacta (1.0.0) solo cambia cuando se cambia aquí. Ver las notas de
# cada versión en https://github.com/athomo001/kudawiki/releases antes de actualizar.
KUDAWIKI_VERSION=1

# URL con la que se entra a la wiki. Fuera de localhost tiene que ser https://: si no, la wiki
# no arranca (SPEC §21.2.1). El TLS lo termina un proxy inverso delante (Caddy, nginx, Traefik)
# o la propia wiki con tls.cert_file y tls.key_file en kudawiki.yaml.
KUDAWIKI_BASE_URL=http://localhost:8080

# true si hay un proxy inverso delante: la IP de cada persona sale de X-Forwarded-For (rate
# limit, auditoría, sesiones) y lo que llegue al proxy por http se redirige a https.
KUDAWIKI_TRUST_PROXY=false

# Primer superadmin, solo para `docker compose run --rm init`.
# La contraseña no va aquí: init la pide por consola.
KUDAWIKI_INIT_EMAIL=tu@empresa.cl
KUDAWIKI_INIT_NAME=Tu Nombre

# Redes que pueden leer /metrics (Prometheus), separadas por comas. Vacío: nadie (SPEC §13.5).
# KUDAWIKI_METRICS_ALLOW_CIDRS=10.0.0.0/8
# Servidor NTP para medir el desfase del reloj; Salud avisa sobre 2 s (SPEC §21.2.5).
# KUDAWIKI_TIME_NTP_SERVER=pool.ntp.org
